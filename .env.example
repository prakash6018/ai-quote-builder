APP_URL=http://localhost:3001
# Where quotes and uploaded drawings are stored (JSON + files).
DATA_DIR=.data
# USD -> INR rate fixed onto new INR quotes.
FX_USD_INR=84

# Vision extraction. Without a key, the bundled sample drawings are read offline
# and other uploads get a low-confidence guess for the reviewer to fill in.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1     # or Azure OpenAI / any compatible endpoint
# VISION_MODEL=gpt-4o

# Stripe (test mode). Without both, deposits use the built-in simulated checkout.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...              # stripe listen --forward-to localhost:3001/api/webhooks/stripe

# Razorpay (test mode).
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...
